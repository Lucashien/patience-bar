rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(coupleId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    match /couples/{coupleId} {
      // Random, unlisted invitation IDs allow joining, never private reads.
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow list: if false;
      allow create: if signedIn()
        && coupleId.matches('^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{12}$')
        && request.resource.data.keys().hasOnly(['members', 'inviteCode', 'createdAt'])
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.inviteCode == coupleId
        && request.resource.data.createdAt == request.time;

      // Add yourself once, preserve the owner, and change no other fields.
      // Existing members may repeat arrayUnion safely for retry/recovery.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && (request.resource.data.members == resource.data.members
            && request.auth.uid in resource.data.members
          || resource.data.members.size() == 1
            && !(request.auth.uid in resource.data.members)
            && request.resource.data.members is list
            && request.resource.data.members.size() == 2
            && request.resource.data.members.hasAll(resource.data.members)
            && request.auth.uid in request.resource.data.members);

      match /users/{uid} {
        allow read: if isMember(coupleId);
        allow create, update: if isMember(coupleId)
          && uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members
          && (uid == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'base', 'updatedAt', 'dayKey', 'pokeLossToday', 'chargeGainToday', 'combo', 'lastPokeAt'
            ]));
      }
      match /events/{eventId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.targetId in
            get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
      }
    }
  }
}
